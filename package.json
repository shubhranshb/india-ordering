{
  "name": "india-ordering",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "typecheck": "for p in packages/core packages/providers packages/agent packages/mcp packages/auth-cli apps/cli; do tsc --noEmit -p $p/tsconfig.json || exit 1; done && echo 'typecheck ok'",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test",
    "order": "pnpm --filter @io/cli start",
    "auth": "tsx packages/auth-cli/src/index.ts",
    "auth:status": "tsx packages/auth-cli/src/index.ts status",
    "auth:verify": "tsx packages/auth-cli/src/index.ts verify",
    "auth:clear": "tsx packages/auth-cli/src/index.ts clear",
    "setup:env": "tsx scripts/setup-env.ts",
    "telegram:set-webhook": "tsx scripts/telegram-webhook.ts set",
    "telegram:webhook-info": "tsx scripts/telegram-webhook.ts info",
    "mcp:inspect": "npx @modelcontextprotocol/inspector npx tsx packages/mcp/src/bin/zepto.ts",
    "dev:web": "pnpm --filter @io/web dev",
    "build:web": "pnpm --filter @io/web build"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
