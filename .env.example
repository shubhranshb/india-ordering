# ---- LLM (required) ----
# gemini = free tier, no credit card. See docs/CREDENTIALS.md
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemini-3.6-flash

# ---- Telegram (required for the bot) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=

# ---- State (required on Vercel, optional locally) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Namespaces every key. Use a different value per person so two deployments
# can share one Redis without seeing each other's data.
KEY_PREFIX=default

# ---- Cost guardrails ----
# The agent hard-stops when any of these is hit, before making the API call.
# Defaults are well inside the Gemini free tier.
DAILY_REQUEST_LIMIT=200
DAILY_TOKEN_LIMIT=500000
MAX_OUTPUT_TOKENS=800
REQUESTS_PER_MINUTE=10

# ---- Cron ----
CRON_SECRET=

# ---- Tier 1 only: the Playwright worker ----
# Leave blank to run Tier 0 (deep-links only).
WORKER_URL=
WORKER_TOKEN=
SESSION_ENCRYPTION_KEY=

# Preview cart writes instead of touching your real account.
DRY_RUN=false
